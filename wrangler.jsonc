
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vclass2026",
	"compatibility_date": "2026-04-08",
	"pages_build_output_dir": "./dist",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// KV: rate limiting partilhado entre isolates Workers
	// Criar com: npx wrangler kv namespace create RATE_LIMIT
	//            npx wrangler kv namespace create RATE_LIMIT --preview
	// E colar os IDs devolvidos abaixo.
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT",
			"id": "f76508cb81b84f67be91eff695c802f6",
			"preview_id": "98b0e06d13a5470bae3a6328e313e2e5",
			"remote": false
		}
	]
	// Environment variables (set via wrangler secrets or .dev.vars):
	// - SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
	// - JWT_SECRET (≥16 chars)
	// - VIDEO_SECRET (HMAC para tokens de vídeo curtos, ≥32 chars)
	// - BUNNY_API_KEY        (master key da Stream Library — server-only)
	// - BUNNY_LIBRARY_ID     (id numérico da Library)
	// - BUNNY_CDN_HOST       (ex: vz-xxxxxx.b-cdn.net — para signed HLS)
	// - BUNNY_TOKEN_KEY      (Token Authentication Key da Library Security)
	// - ALLOWED_ORIGINS (CSV de origens permitidas em CORS)
}