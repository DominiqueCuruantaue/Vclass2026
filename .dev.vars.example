# VClass Development Environment Variables
# Copy this file to .dev.vars and fill in your actual values

# Supabase Configuration (REQUIRED)
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Demo mode: if SUPABASE_URL/SUPABASE_ANON_KEY are left unset, login normally
# refuses all requests. Set this to 'true' to allow logging in with the fixed
# demo password (vclass2024) against the mock accounts in src/middleware/database.ts.
# Leave unset (or 'false') in any production-like environment.
ALLOW_DEMO_MODE=true

# JWT Secret (REQUIRED)
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# Video Streaming (REQUIRED)
# Bunny.net CDN URL or Cloudflare Stream URL
BUNNY_CDN_URL=https://your-zone.b-cdn.net

# Optional: Bunny.net API (for video upload)
BUNNY_API_KEY=your-bunny-api-key
BUNNY_LIBRARY_ID=your-library-id

# Optional: Email Service (Resend) — used for teacher application emails
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=VClass <onboarding@resend.dev>

# Optional: Payment Gateway (for future)
STRIPE_SECRET_KEY=your-stripe-key
STRIPE_WEBHOOK_SECRET=your-webhook-secret

# Teacher Earnings — Monthly settlement (PDR-007)
# Shared secret checked by POST /api/internal/settlement/:phase — must match
# the SETTLEMENT_CRON_SECRET GitHub Actions secret used by
# .github/workflows/teacher-earnings-settlement.yml. Generate with:
# openssl rand -base64 32
SETTLEMENT_CRON_SECRET=your-settlement-cron-secret
